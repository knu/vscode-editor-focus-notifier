{
  "name": "editor-focus-notifier",
  "displayName": "Editor Focus Notifier",
  "description": "Notifies external tools when entering/leaving the text editor area",
  "version": "0.2.1",
  "publisher": "knu",
  "author": "Akinori Musha",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/knu/vscode-editor-focus-notifier"
  },
  "bugs": {
    "url": "https://github.com/knu/vscode-editor-focus-notifier/issues"
  },
  "homepage": "https://github.com/knu/vscode-editor-focus-notifier#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Editor Focus Notifier",
      "properties": {
        "editorFocusNotifier.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable focus state detection and command execution."
        },
        "editorFocusNotifier.onEnterEditorCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command to run when entering editor state."
        },
        "editorFocusNotifier.onEnterTerminalCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command to run when entering terminal state."
        },
        "editorFocusNotifier.onEnterOtherCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command to run when entering other state."
        }
      }
    },
    "commands": [
      {
        "command": "editorFocusNotifier.showCurrentState",
        "title": "Editor Focus Notifier: Show Current State"
      },
      {
        "command": "editorFocusNotifier.forceReevaluate",
        "title": "Editor Focus Notifier: Force Reevaluate"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "lint:eslint": "eslint src --ext ts",
    "lint": "npm-run-all -s --continue-on-error format:check lint:eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm-run-all -s --continue-on-error lint typecheck",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "test:run": "vscode-test",
    "test": "npm-run-all -s compile test:run",
    "ci": "npm-run-all -s check test",
    "package": "vsce package",
    "publish": "npm run publish:vsce && npm run publish:ovsx",
    "publish:vsce": "vsce publish --packagePath \"$(npm pkg get name version | jq -rs '.[0] | \"\\(.name)-\\(.version).vsix\"')\"",
    "publish:ovsx": "ovsx publish --packagePath \"$(npm pkg get name version | jq -rs '.[0] | \"\\(.name)-\\(.version).vsix\"')\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "npm-run-all2": "^8.0.4",
    "ovsx": "^0.10.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
